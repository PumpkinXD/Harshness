{
    "appId": "io.github.pumpkinxd.harshness",
    "productName": "Harshness",
    "files": [
        "package.json",
        "index.html",
        "styles.css",
        "preload.js",
        "webview-preload.js",
        "renderer.js",
        "main.js"
    ],
    "directories": {
        "output": "build"
    },
    "linux": {
        "target": [
            "AppImage"
        ]
    },
    "win": {
        "target": [
            {
                "target": "portable",
                "arch": [
                    "ia32",
                    "x64"
                ]
            }
        ]
    },
    "mac": {
        "target": [
            {
                "target": "dmg",
                "arch": [
                    "universal"
                ]
            }
        ]
    }
}
